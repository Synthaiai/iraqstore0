{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com')",
      ".indexOn": ["category", "gender", "sortOrder", "status"]
    },
    "catalog": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com')"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com')"
    },
    "deliveryFees": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com')"
    },
    "orders": {
      ".read": "auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com')",
      ".indexOn": ["status", "createdAt", "phone"],
      "$orderId": {
        ".read": "auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com')",
        ".write": "data.val() == null || (auth != null && (auth.token.email == 'adminiraq@gmail.com' || auth.token.email == 'adoiniraqstore@gmail.com'))",
        ".validate": "newData.hasChildren(['id', 'orderNo', 'name', 'phone', 'governorate', 'city', 'address', 'total', 'cart']) && newData.child('name').isString() && newData.child('phone').isString() && newData.child('total').isNumber()"
      }
    }
  }
}
