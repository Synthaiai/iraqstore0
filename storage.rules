rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product and store assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.email == 'adminiraq@gmail.com' || request.auth.token.email == 'adminiraqstore@gmail.com' || request.auth.token.email == 'adoiniraqstore@gmail.com') &&
        request.resource.size < 10 * 1024 * 1024; // 10MB max upload
    }
  }
}
