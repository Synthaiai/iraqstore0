rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'adminiraq@gmail.com' || request.auth.token.email == 'adminiraqstore@gmail.com' || request.auth.token.email == 'adoiniraqstore@gmail.com') &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if request.auth != null &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'adminiraq@gmail.com' || request.auth.token.email == 'adminiraqstore@gmail.com' || request.auth.token.email == 'adoiniraqstore@gmail.com');
    }
  }
}
