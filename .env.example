# Public Turnstile site key. This value is safe to expose in the browser bundle.
VITE_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Image hosting (optional but strongly recommended).
# Without these, product photos are stored inline in the database: every photo
# costs ~4x its size as text, every shopper downloads them, and saving a product
# is slow on a mobile connection. With them, only a short URL is stored.
# Cloudinary → Settings → Upload → add an UNSIGNED upload preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Simpler alternative: set VITE_IMAGE_PROVIDER=imgbb and fill this instead.
VITE_IMGBB_API_KEY=
